# Data — by default third-party dataset files are not committed (see
# docs/dataset_acquisition.md). fraud_oracle.csv and its derived scored-claims
# file are explicitly allowed below, included for the deployed demo only after
# confirming redistribution is permitted under the dataset's Kaggle license.
data/raw/*
!data/raw/.gitkeep
!data/raw/fraud_oracle.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/scored_test_claims.csv

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (top-level only — src/models/ is source code, not an artifact dir)
*.pkl
*.joblib
/models/

# Environment / secrets
.env

# OS
.DS_Store

# IDE
.vscode/
.idea/

# MLflow
mlruns/
